# Optional legacy warm-up URL (browser → HF directly; needs CORS on ALLOWED_ORIGINS).
# Prefer built-in GET /api/health BFF warm-up (no env required).
NEXT_PUBLIC_API_URL=

# Server-only backend settings. Do NOT expose secrets via NEXT_PUBLIC_* variables.
# Local FastAPI (typical): http://127.0.0.1:7861 — must match `uvicorn --port` (not always 8000).
# Next proxies: /api/v1/analyze, /api/v1/generate-questions, /api/v1/gemini/health-check.
# BACKEND_API_KEY must match backend API_KEY when REQUIRE_API_KEY=true.
# Backend ALLOWED_ORIGINS must include http://localhost:3000 for browser → Next → backend.
BACKEND_API_BASE_URL=http://127.0.0.1:7861
BACKEND_API_KEY=
